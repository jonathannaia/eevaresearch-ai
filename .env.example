# EevaResearch AI — environment configuration (Foundation phase)
#
# Nothing in this file is required to run the app. Phase 1 is 100% demo/mock
# data read from data/seed/ — there are no live providers, no API keys, and
# no LLM calls anywhere in this build. This file exists so Phase 2/3 have a
# documented place to add real configuration later, without a code rewrite.

# App version string shown in the footer. Not required — defaults in code.
# EDGE_APP_VERSION=0.1.0-foundation

# Data mode. Always "demo" in this phase regardless of this value — the
# field exists in src/config/settings.py so a future "live" mode can be
# introduced without a UI rewrite. Not required.
# EDGE_DATA_MODE=demo

# --- Reserved for Phase 2 (data integration) — none of these are read by
# any code in this phase. See IMPLEMENTATION_NOTES.md for the plan. ---
# EDGE_MARKET_DATA_API_KEY=
# EDGE_EVIDENCE_SOURCE_API_KEY=
# ANTHROPIC_API_KEY=

# --- Korea DART radar pilot (Samsung Electronics / SK Hynix, Memory + AI
# Buildout themes only) — see design/DECISIONS.md. Both required for the
# Radar Inbox to do anything live; without them it shows a clear
# missing-configuration state rather than guessing or crashing. Demo mode
# (Dashboard, Themes, Signals, everything else) works with neither set.

# OpenDART API key. Get one free (20,000 req/day) at
# https://opendart.fss.or.kr/uss/umt/login/loginPage.do
# EDGE_DART_API_KEY=

# DeepL API key (free tier). Get one at https://www.deepl.com/pro-api
# Used only to translate extracted Korean filing titles/excerpts for display
# — the Korean original always stays the authoritative source; English is
# always labeled as a machine translation, never treated as a Fact.
# EDGE_TRANSLATION_API_KEY=

# SEC EDGAR identifying contact string — required by SEC's own access
# policy (https://www.sec.gov/os/accessing-edgar-data), NOT a secret and
# NOT an API key (EDGAR needs no key at all). Format: "AppName contact@email".
# Requests without a real identifying User-Agent are rejected (403) and may
# be temporarily IP-blocked — do not leave this as a placeholder value.
# EDGE_EDGAR_USER_AGENT=

# EDINET (Japan) Subscription-Key — planning Gate 1, fixture-only. This
# credential is never read, validated, printed, logged, or used in any
# live request this gate; the field exists only so a later live-validation
# gate has a single, already-wired configuration seam to fill in.
# EDGE_EDINET_SUBSCRIPTION_KEY=

# --- Private-beta access foundation, Phase 1 (configuration + gating only —
# see design/DECISIONS.md). Leave auth disabled until real sign-in is
# implemented; there is no Google/OIDC login in this phase. The allowlist
# below is authorization only — listing an email here does not authenticate
# anyone, since no identity check exists yet. Do NOT put Google OAuth
# client/cookie secrets or any other credential in this file — those belong
# only in .streamlit/secrets.toml (gitignored), never in .env.example. ---

# Feature flag. Recognized true values (case-insensitive, trimmed): 1, true,
# yes, on. Anything else — absent, blank, or unrecognized — stays disabled,
# which keeps every page open with no configuration, exactly like today.
# EDGE_PRIVATE_BETA_AUTH_ENABLED=false

# Comma-separated beta-tester emails. Not a secret by itself, but not a
# credential either — matching an address on this list only clears the
# authorization check once real sign-in exists; it enables nothing on its
# own while EDGE_PRIVATE_BETA_AUTH_ENABLED is false.
# EDGE_PRIVATE_BETA_ALLOWED_EMAILS=founder@example.com,tester@example.com

# --- R2 remote-cache sync (dormant infrastructure — see
# src/data_access/remote_cache/). Nothing in the app reads or writes
# through this yet; no page, pipeline, or repository is wired to it.
# Leave EDGE_REMOTE_CACHE_ENABLED unset/false until that future wiring
# lands — local data/cache/*.json stays the only behavior either way.
# EDGE_R2_ENDPOINT, EDGE_R2_ACCESS_KEY_ID, EDGE_R2_SECRET_ACCESS_KEY, and
# EDGE_R2_BUCKET are required together; a partial set is treated as "not
# configured," never guessed or partially used. EDGE_R2_ACCOUNT_ID is
# optional metadata only — not required for the connection to work. ---

# Feature flag. Same recognized true values as EDGE_PRIVATE_BETA_AUTH_ENABLED
# (case-insensitive, trimmed): 1, true, yes, on. Anything else stays disabled.
# EDGE_REMOTE_CACHE_ENABLED=false

# Cloudflare account ID that owns the R2 bucket. Not itself a secret, but
# kept alongside the other R2 values rather than hardcoded.
# EDGE_R2_ACCOUNT_ID=

# R2 access key ID (S3-compatible credential pair, first half).
# EDGE_R2_ACCESS_KEY_ID=

# R2 secret access key (S3-compatible credential pair, second half). A real
# secret — never commit a real value here or anywhere in this repo.
# EDGE_R2_SECRET_ACCESS_KEY=

# Name of the private R2 bucket Radar's cache sync writes to/reads from.
# EDGE_R2_BUCKET=

# R2's S3-compatible endpoint URL for this account
# (https://developers.cloudflare.com/r2/api/s3/api/).
# EDGE_R2_ENDPOINT=

# --- EDGAR issuer-discovery preview harness (dormant infrastructure —
# see src/data_access/edgar/discovery_service.py). No real cross-issuer
# SEC endpoint is chosen or implemented yet, so there is nothing this flag
# can currently enable end-to-end; it exists only so a future, separately-
# approved live-discovery gate has an already-fail-closed-by-default
# setting to read. Same recognized true values as the flags above:
# 1, true, yes, on. Anything else stays disabled. ---
# EDGE_EDGAR_DISCOVERY_ENABLED=false

# --- Durable-State Phase 1 (dormant — see src/data_access/state_db/).
# "json" (the default, used whenever this is unset/blank/unrecognized)
# keeps every existing JSON-cache-backed code path exactly as today;
# "sqlite" is a local-development/test-only opt-in — no pipeline or page
# in this app actually branches on this value yet, this phase is the
# storage layer only. IMPORTANT: a local SQLite file is NOT a
# hosted-durable-storage answer on its own — treat it as ephemeral on
# Streamlit Community Cloud unless a persistent volume is separately
# verified and explicitly approved. ---
# EDGE_DB_BACKEND=json

# Local filesystem path to the SQLite database file, only relevant when
# EDGE_DB_BACKEND=sqlite. No default is invented if this is unset.
# Deliberately its own EDGE_STATE_DB_* name, not EDGE_DB_PATH — this
# repo's real local .env already defines an unrelated, pre-"foundation
# rebuild" EDGE_DB_PATH (see design/DECISIONS.md); this is a distinct
# variable with no backward-compatible alias to that old one.
# EDGE_STATE_DB_PATH=

# Reserved for a future managed-database connection string. Read for
# presence only in this phase — never parsed, validated, or connected to;
# setting this alone triggers no network behavior of any kind.
# EDGE_STATE_DB_URL=
